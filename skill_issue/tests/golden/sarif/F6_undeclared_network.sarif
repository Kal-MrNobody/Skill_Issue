{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill-scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/cisco-ai-defense/skill-scanner",
          "rules": [
            {
              "id": "SOCIAL_ENG_MISLEADING_DESC",
              "name": "Social Eng Misleading Desc",
              "shortDescription": {
                "text": "Potential description-behavior mismatch"
              },
              "fullDescription": {
                "text": "Skill performs actions not reflected in its description"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "social_engineering",
                "severity": "MEDIUM",
                "tags": [
                  "social_engineering",
                  "security"
                ]
              },
              "help": {
                "text": "Ensure description accurately reflects all skill capabilities",
                "markdown": "**Remediation**: Ensure description accurately reflects all skill capabilities"
              }
            },
            {
              "id": "TOOL_ABUSE_UNDECLARED_NETWORK",
              "name": "Tool Abuse Undeclared Network",
              "shortDescription": {
                "text": "Undeclared network usage"
              },
              "fullDescription": {
                "text": "Skill code uses network libraries but doesn't declare network requirement"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "unauthorized_tool_use",
                "severity": "MEDIUM",
                "tags": [
                  "unauthorized_tool_use",
                  "security"
                ]
              },
              "help": {
                "text": "Declare network usage in compatibility field or remove network calls",
                "markdown": "**Remediation**: Declare network usage in compatibility field or remove network calls"
              }
            },
            {
              "id": "MANIFEST_MISSING_LICENSE",
              "name": "Manifest Missing License",
              "shortDescription": {
                "text": "Skill does not specify a license"
              },
              "fullDescription": {
                "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "INFO",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)",
                "markdown": "**Remediation**: Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
              }
            },
            {
              "id": "DATA_EXFIL_NETWORK_REQUESTS",
              "name": "Data Exfil Network Requests",
              "shortDescription": {
                "text": "Outbound network request primitives that can transmit data externally"
              },
              "fullDescription": {
                "text": "Pattern detected: urllib.request.Request("
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "data_exfiltration",
                "severity": "MEDIUM",
                "tags": [
                  "data_exfiltration",
                  "security"
                ]
              },
              "help": {
                "text": "Ensure network operations are necessary and document allowed destinations",
                "markdown": "**Remediation**: Ensure network operations are necessary and document allowed destinations"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SOCIAL_ENG_MISLEADING_DESC",
          "level": "warning",
          "message": {
            "text": "Skill performs actions not reflected in its description"
          },
          "properties": {
            "category": "social_engineering",
            "severity": "MEDIUM",
            "remediation": "Ensure description accurately reflects all skill capabilities"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "DESC_BEHAVIOR_MISMATCH_f510ddaee7"
          }
        },
        {
          "ruleId": "TOOL_ABUSE_UNDECLARED_NETWORK",
          "level": "warning",
          "message": {
            "text": "Skill code uses network libraries but doesn't declare network requirement"
          },
          "properties": {
            "category": "unauthorized_tool_use",
            "severity": "MEDIUM",
            "remediation": "Declare network usage in compatibility field or remove network calls"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "TOOL_MISMATCH_NETWORK_b8a162075f"
          }
        },
        {
          "ruleId": "MANIFEST_MISSING_LICENSE",
          "level": "note",
          "message": {
            "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
          },
          "properties": {
            "category": "policy_violation",
            "severity": "INFO",
            "remediation": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "MANIFEST_MISSING_LICENSE_c5ae9be793"
          }
        },
        {
          "ruleId": "DATA_EXFIL_NETWORK_REQUESTS",
          "level": "warning",
          "message": {
            "text": "Pattern detected: urllib.request.Request("
          },
          "properties": {
            "category": "data_exfiltration",
            "severity": "MEDIUM",
            "remediation": "Ensure network operations are necessary and document allowed destinations"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/format.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7,
                  "snippet": {
                    "text": "req = urllib.request.Request("
                  }
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "DATA_EXFIL_NETWORK_REQUESTS_f1055fcbf5"
          }
        },
        {
          "ruleId": "DATA_EXFIL_NETWORK_REQUESTS",
          "level": "warning",
          "message": {
            "text": "Pattern detected: urllib.request.urlopen("
          },
          "properties": {
            "category": "data_exfiltration",
            "severity": "MEDIUM",
            "remediation": "Ensure network operations are necessary and document allowed destinations"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/format.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 11,
                  "snippet": {
                    "text": "urllib.request.urlopen(req, timeout=2)"
                  }
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "DATA_EXFIL_NETWORK_REQUESTS_339abee819"
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "endTimeUtc": "2026-10-24T09:50:04Z"
        }
      ]
    }
  ]
}