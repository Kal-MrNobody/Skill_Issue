# Copy to .env and fill in. Never commit .env.

# One seed per agent (long random strings; they determine each agent's address)
ORCHESTRATOR_SEED=
INTAKE_SEED=
SECURITY_SEED=
BENCHMARK_SEED=
REPORT_SEED=

# Agentverse (mailbox registration)
AGENTVERSE_API_KEY=

# Model used by the benchmark. The key stays on the host: the sandbox talks to a key-injecting proxy.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# Optional: raises GitHub API rate limits for intake
GITHUB_TOKEN=
